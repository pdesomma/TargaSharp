<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>True</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TargaSharp\TargaSharp.csproj" />
    <ProjectReference Include="..\TargaSharp.Drawing\TargaSharp.Drawing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fixtures live in .tests\Fixtures\ (shared with TargaSharp.Tests / TargaSharp.Drawing.Tests, see
         TASK M12); Link projects them back under Examples\ so the sample app's UI and behavior are
         unchanged. -->
    <None Include="..\.tests\Fixtures\**" Link="Examples\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
