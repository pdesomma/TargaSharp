<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
    <Version>0.2.0</Version>
    <Title>TargaSharp</Title>
    <Authors>Patrick DeSomma</Authors>
    <Description>.NET 6/8/10 library for reading and writing .tga image files.</Description>
    <PackageProjectUrl>https://github.com/pdesomma/TargaSharp</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/pdesomma/TargaSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>tga;targa</PackageTags>
    <PackageReleaseNotes>0.2.0: records, validation, typed exceptions, TargaSharp.Drawing split, naming cleanup. Breaking changes from 0.1.0.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
